{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "logs",
      "title": "审计日志流（按用户/动作筛选）",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"docker\", container=~\"xiaoshutong-backend.*\"} | json | logger=\"audit\" | regexp `action=(?P<audit_action>\\S+) user=(?P<audit_user>\\S+) target=(?P<audit_target>\\S*) detail=(?P<audit_detail>\\S*) ip=(?P<audit_ip>\\S+)` | audit_action=~\"$audit_action\" | audit_user=~\"$audit_user\""
        }
      ],
      "options": { "showTime": true, "wrapLogMessage": true, "showLabels": false, "enableLogDetails": true },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "审计写操作量（按 action）",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (audit_action) (count_over_time({job=\"docker\", container=~\"xiaoshutong-backend.*\"} | json | logger=\"audit\" | regexp `action=(?P<audit_action>\\S+)` [$__interval]))",
          "legendFormat": "{{audit_action}}"
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "lines", "fillOpacity": 10, "lineWidth": 1 }, "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum", "last"] } }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "审计失败/错误数（error 或 http_4xx/5xx）",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"docker\", container=~\"xiaoshutong-backend.*\"} | json | logger=\"audit\" | regexp `detail=(?P<audit_detail>error|http_[45]..)` [5m]))",
          "legendFormat": "失败/错误"
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "lines", "lineWidth": 2, "fillOpacity": 15 }, "color": { "mode": "fixed", "fixedColor": "red" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "各用户操作数 Top10",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (audit_user) (count_over_time({job=\"docker\", container=~\"xiaoshutong-backend.*\"} | json | logger=\"audit\" | regexp `user=(?P<audit_user>\\S+)` [1h])))",
          "legendFormat": "{{audit_user}}"
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 80, "lineWidth": 1 }, "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] } }
    },
    {
      "id": 5,
      "type": "logs",
      "title": "后端 ERROR 日志（非审计）",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"docker\", container=~\"xiaoshutong-backend.*\"} | json | level=\"ERROR\""
        }
      ],
      "options": { "showTime": true, "wrapLogMessage": true, "showLabels": false, "enableLogDetails": true },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "后端日志量（按 level）",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (level) (count_over_time({job=\"docker\", container=~\"xiaoshutong-backend.*\"} | json [5m]))",
          "legendFormat": "{{level}}"
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "lines", "fillOpacity": 10, "lineWidth": 1 }, "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum", "last"] } }
    }
  ],
  "schemaVersion": 39,
  "tags": ["xiaoshutong", "audit", "loki"],
  "templating": {
    "list": [
      {
        "name": "audit_user",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values({job=\"docker\", container=~\"xiaoshutong-backend.*\"} | json | logger=\"audit\" | regexp `user=(?P<audit_user>\\S+)`, audit_user)",
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": { "text": "All", "value": ".*" },
        "refresh": 2
      },
      {
        "name": "audit_action",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values({job=\"docker\", container=~\"xiaoshutong-backend.*\"} | json | logger=\"audit\" | regexp `action=(?P<audit_action>\\S+)`, audit_action)",
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": { "text": "All", "value": ".*" },
        "refresh": 2
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "小书童 - 审计与日志看板",
  "uid": "xiaoshutong-audit",
  "version": 1,
  "refresh": "30s"
}
