# 小书童 - Grafana 告警规则（文件预置，统一告警引擎评估 Loki 查询）
# 触发后按 observability/grafana/provisioning/alerting/policies.yaml 路由到通知渠道。
apiVersion: 1

groups:
  - name: 小书童审计告警
    rules:
      # 1) 审计写操作失败/错误激增（detail = error 或 http_4xx/5xx）
      - alert: 审计写操作失败激增
        expr: |
          sum(count_over_time({job="docker", container=~"xiaoshutong-backend.*"} | json | logger="audit" | regexp `detail=(?P<det>error|http_[45]..)` [5m])) > 5
        for: 5m
        labels:
          severity: warning
          category: audit
        annotations:
          summary: "近 5 分钟审计失败/错误操作 {{ $value }} 次"
          description: "审计写操作出现 error 或 http_4xx/5xx 响应增多，可能遭遇异常操作或攻击，请排查。"

      # 2) 知识库删除等敏感操作实时通知（每次发生即告警，便于合规留痕与追责）
      - alert: 知识库删除操作
        expr: |
          sum(count_over_time({job="docker", container=~"xiaoshutong-backend.*"} | json | logger="audit" | regexp `action=(?P<audit_action>DELETE /api/kb/.*)` [1m])) > 0
        for: 0s
        labels:
          severity: info
          category: audit
        annotations:
          summary: "发生知识库删除操作"
          description: "检测到 DELETE /api/kb/ 删除操作，msg 见 Grafana 日志面板，用于合规留痕与追责。"

      # 3) 后端 ERROR 日志激增（非审计的崩溃/未捕获异常/依赖故障）
      - alert: 后端错误日志激增
        expr: |
          sum(count_over_time({job="docker", container=~"xiaoshutong-backend.*"} | json | level="ERROR" [5m])) > 10
        for: 5m
        labels:
          severity: warning
          category: backend
        annotations:
          summary: "后端 ERROR 日志近 5 分钟 {{ $value }} 条"
          description: "后端出现大量 ERROR 日志，可能存在未捕获异常或依赖故障，请查看 Grafana 日志面板。"
