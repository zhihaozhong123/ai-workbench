{
  "schema_version": 1,
  "slug": "wechat-article-publish",
  "name": "公众号文章批量发布",
  "version": "1.1.0",
  "description": "把内容草稿一键发布到微信公众号，支持 NLP 自动生成标题/摘要/关键词/封面图描述。",
  "author": "zhihaozhong123",
  "emoji": "📤",
  "category": "公众号",
  "homepage": "https://github.com/zhihaozhong123/wechat-article-publish",
  "runtime": {
    "type": "python",
    "entry": "scripts/main.py",
    "cli": "run",
    "timeout_seconds": 30,
    "env_whitelist": ["WECHAT_APP_ID", "WECHAT_APP_SECRET"]
  },
  "system_prompt_file": "AGENT.md",
  "permissions": ["network"],
  "min_app_version": "0.1.0"
}
